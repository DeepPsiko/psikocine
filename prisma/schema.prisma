datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id          String   @id @default(cuid())
  name        String
  username    String   @unique
  email       String?  @unique
  password    String
  avatar      String?
  bio         String?  @default("Amante del buen cine y miembro de Psikos.")
  role        String   @default("USER") // "USER" | "ADMIN"
  isBlocked   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ratings            Rating[]
  reviews            Review[]
  reviewLikes        ReviewLike[]
  reviewReplies      ReviewReply[]
  favorites          Favorite[]
  watchlists         Watchlist[]
  proposedCandidates SaturdayCandidate[]
  saturdayVotes      SaturdayVote[]
  notifications      Notification[]
}

model Movie {
  id            String   @id @default(cuid())
  title         String
  originalTitle String?
  year          Int
  description   String
  poster        String
  backdrop      String?
  duration      Int      // En minutos
  director      String
  cast          String   // Lista separada por comas
  country       String?  @default("Internacional")
  trailerUrl    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  genres            MovieGenre[]
  ratings           Rating[]
  reviews           Review[]
  favorites         Favorite[]
  watchlists        Watchlist[]
  saturdayCandidates SaturdayCandidate[]
  saturdayWon       SaturdayEvent[]     @relation("WinnerMovie")
}

model Genre {
  id        String       @id @default(cuid())
  name      String       @unique
  slug      String       @unique
  movies    MovieGenre[]
}

model MovieGenre {
  id      String @id @default(cuid())
  movieId String
  genreId String

  movie   Movie  @relation(fields: [movieId], references: [id], onDelete: Cascade)
  genre   Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@unique([movieId, genreId])
}

model Rating {
  id        String   @id @default(cuid())
  value     Float    // De 1.0 a 5.0 (admite medias estrellas como 4.5)
  userId    String
  movieId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
}

model Review {
  id         String        @id @default(cuid())
  content    String
  hasSpoiler Boolean       @default(false)
  isHidden   Boolean       @default(false)
  userId     String
  movieId    String
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie      Movie         @relation(fields: [movieId], references: [id], onDelete: Cascade)
  likes      ReviewLike[]
  replies    ReviewReply[]
}

model ReviewLike {
  id        String   @id @default(cuid())
  userId    String
  reviewId  String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([userId, reviewId])
}

model ReviewReply {
  id        String   @id @default(cuid())
  content   String
  userId    String
  reviewId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  movieId   String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
}

model Watchlist {
  id        String   @id @default(cuid())
  userId    String
  movieId   String
  isWatched Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
}

model SaturdayEvent {
  id             String              @id @default(cuid())
  title          String
  date           DateTime
  votingDeadline DateTime
  status         String              @default("VOTING") // "SCHEDULED" | "VOTING" | "FINISHED"
  winnerMovieId  String?
  notes          String?             @default("")
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  winnerMovie    Movie?              @relation("WinnerMovie", fields: [winnerMovieId], references: [id], onDelete: SetNull)
  candidates     SaturdayCandidate[]
  votes          SaturdayVote[]
}

model SaturdayCandidate {
  id           String         @id @default(cuid())
  saturdayId   String
  movieId      String
  proposedById String
  createdAt    DateTime       @default(now())

  saturday     SaturdayEvent  @relation(fields: [saturdayId], references: [id], onDelete: Cascade)
  movie        Movie          @relation(fields: [movieId], references: [id], onDelete: Cascade)
  proposedBy   User           @relation(fields: [proposedById], references: [id], onDelete: Cascade)
  votes        SaturdayVote[]

  @@unique([saturdayId, movieId])
}

model SaturdayVote {
  id          String            @id @default(cuid())
  saturdayId  String
  candidateId String
  userId      String
  createdAt   DateTime          @default(now())

  saturday    SaturdayEvent     @relation(fields: [saturdayId], references: [id], onDelete: Cascade)
  candidate   SaturdayCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([saturdayId, userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("INFO") // "INFO" | "SUCCESS" | "WARNING" | "VOTE" | "WINNER"
  isRead    Boolean  @default(false)
  link      String?  @default("")
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
